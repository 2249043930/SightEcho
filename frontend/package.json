{
  "name": "SightEcho-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.js --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,scss,json}\"",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "element-plus": "^2.6.0",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.8",
    "echarts": "^5.5.0",
    "vue-echarts": "^6.7.0",
    "dayjs": "^1.11.10",
    "@vueuse/core": "^10.9.0",
    "@vueuse/integrations": "^10.9.0",
    "focus-trap": "^7.5.4",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "typescript": "^5.4.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "sass": "^1.72.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.24.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "prettier": "^3.2.0",
