# SightEcho 后端环境变量样例（复制为 .env 后填入真实值）
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
TIMEZONE=Asia/Shanghai

# MySQL（Docker 环境）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=sightecho
MYSQL_CHARSET=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO / 对象存储
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sightecho
MINIO_PUBLIC_BASE=http://127.0.0.1:9000

# JWT（生产环境请改为 32+ 位随机串）
JWT_SECRET=please-change-me-to-32-or-more-random-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# AI 服务商（qwen / openai / joyai）
AI_PROVIDER=joyai
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_VL_MODEL=qwen-vl-max
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# JoyAI-VL-Interaction（京东云 JoyBuilder MaaS 平台，Chat 兼容协议）
# 文档：https://docs.jdcloud.com/cn/jdcloud-maas/model-api
# 注意：模型只支持 Chat API，没有原生视频流；视频流场景业务侧用 OpenCV 抽帧后循环喂图
JOYAI_API_KEY=your-joyai-api-key
JOYAI_API_BASE=https://modelservicep.jdcloud.com/v1
JOYAI_VL_MODEL=joyai-vl-interaction
JOYAI_VL_MODE=image                # image = 单图；video = 视频流（多帧）
JOYAI_VIDEO_MAX_FRAMES=8          # 视频模式采样帧数
JOYAI_VIDEO_FPS=1.0               # 视频模式采样帧率

OCR_PROVIDER=baidu
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 邮件（QQ SMTP 示例：smtp.qq.com 端口 465 SSL，授权码登录）
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_USE_SSL=true
EMAIL_USER=your-qq-email@qq.com
EMAIL_PASSWORD=your-qq-auth-code
EMAIL_FROM_NAME=SightEcho 昭视智伴

# CORS（多个用逗号分隔；包含前端 dev/preview 端口）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173

# 限流
RATE_LIMIT_PER_MIN=60
EMAIL_CODE_DAILY_IP_LIMIT=10
EMAIL_CODE_INTERVAL_SEC=60

# 上传
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp

# 降级
FALLBACK_TIMEOUT_SEC=5.0

# 演示模式（未配置 AI Key 时返回固定结果，便于本地体验）
DEMO_MODE=true
